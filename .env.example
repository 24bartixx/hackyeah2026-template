# Copy to `.env` and adjust values: cp .env.example .env
# Auth/JWT settings live in backend/.env (see backend/.env.example).

# --- PostgreSQL (used by the `db` container and by the backend) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
# Hostname of the database as seen by the backend container (compose service name)
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Port exposed on your host machine (e.g. for psql / DBeaver: localhost:5432)
POSTGRES_HOST_PORT=5432

# --- Backend ---
APP_NAME=HackYeah Backend
DEBUG=false
# Echo SQL statements to logs
DB_ECHO=false
BACKEND_HOST_PORT=8000
