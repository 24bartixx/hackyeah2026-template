# Copy to `.env` and adjust values: cp backend/.env.example backend/.env
# Loaded by the `backend` and `migrate` services in docker-compose.yml.

# --- JWT ---
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Send the refresh-token cookie only over HTTPS. Keep false for local http development.
REFRESH_COOKIE_SECURE=false
